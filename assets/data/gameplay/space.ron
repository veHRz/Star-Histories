// Espace de la vue Globale (AGENTS.md §6.4). Réglages de jeu, pas des faits d'univers.
(
    // Recentrage de l'origine flottante quand le point suivi s'en éloigne de plus de 2 km
    // (un f32 y reste précis au dixième de millimètre).
    recenter_distance: 2000.0,

    // Échelle de jeu des systèmes stellaires : PROPOSITION P2 (docs/propositions.md), en
    // attente de l'auteur. Le canon ne donne ni tailles ni orbites : tailles ÷ 10 et
    // distances ÷ 100 par rapport à des ordres de grandeur réels. Longueurs en mètres.
    scale: (
        au: 1.496e9,              // 1 UA de jeu = 1,5 million de km
        first_orbit_au: 0.4,
        orbit_ratio: 1.7,         // rangs à 0,4 ; 0,68 ; 1,16 ; 1,97 ; 3,3… UA de jeu
        star_radius: 7.0e7,       // ≈ 5° dans le ciel à 1 UA de jeu
        planet_radius: 6.4e5,     // monde tellurique : 640 km
        gas_giant_radius: 7.0e6,
        moon_radius: 1.7e5,
        moon_orbit_radii: 12.0,
        parking_orbit_radii: 1.5, // stations et orbites de stationnement : 1,5 rayon d'altitude
        // Croisière : vitesse limite proportionnelle à la distance de la surface la plus proche.
        // M11 (hypothèse, Q19 ; P2 chiffrait 0,15/s et 0,1 c) : plus lente, à la demande de
        // l'auteur du 06/11/2026. Trajets (`SystemScale::cruise_time`) : ≈ 2 à 3,5 min entre
        // planètes voisines (1 à 2 avant), ≈ 1,5 min vers une station à 20 000 km (≈ 1), ≈ 40 s
        // vers une lune (≈ 30). Hub de Vorrhal → chantiers de Vorrh-II à l'autopilote :
        // ≈ 7 min (≈ 4 avant), dont ≈ 4 min plafonnées à 15 000 km/s.
        cruise_rate: 0.10,        // 1/s : la vitesse se multiplie par e toutes les 10 s
        cruise_min_speed: 2000.0, // au-dessus de toute poussée (`manoeuvre_max_speed`)
        cruise_max_speed: 1.5e7,  // 0,05 c
        // Poussée maximale de tout vaisseau, hors croisière (P33 : 1 km/s ; 300 m/s jusqu'à
        // M10). La vitesse de combat est par vaisseau (`flight.ron`).
        manoeuvre_max_speed: 1000.0,
    ),
)
