// Dispositions de clavier : étiquette affichée pour chaque touche physique (nom `KeyCode`) qui
// ne porte pas la lettre de sa position QWERTY. Les liaisons restent physiques ; seules les
// aides changent (Q13 : l'auteur joue en AZERTY, le remappage arrive en M7). Au premier appui,
// le jeu apprend le vrai caractère de chaque touche et corrige l'étiquette.
(
    // Disposition supposée avant tout appui (celle de l'auteur).
    default_layout: "azerty",
    layouts: {
        "qwerty": {},
        "azerty": {
            "KeyQ": "A",
            "KeyA": "Q",
            "KeyW": "Z",
            "KeyZ": "W",
            "KeyM": ",",
            "Semicolon": "M",
        },
    },
)
