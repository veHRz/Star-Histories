// Classes de vaisseaux, catégories et préfixes — transcription manuelle de l'export (§2.4).
// « Aucun bouclier énergétique : seul le blindage protège » (§2.4, §11.2).
(
    classes: [
        (
            id: "chasseur",
            name: "Chasseur",
            length_m: (min: 10, max: 20),
            crew: (min: 1, max: 2),
            hyperdrive: RarelyYes,
            ever_built: true,
            role_note: "Combat léger, escorte ; dépend d'un porteur. Classe légère non conventionnée : diffère totalement d'une faction à l'autre. De rares chasseurs long-courriers ont l'hyperpropulsion.",
            source: "§2.4",
        ),
        (
            id: "bombardier",
            name: "Bombardier",
            length_m: (min: 15, max: 30),
            crew: (min: 2, max: 4),
            hyperdrive: RarelyYes,
            ever_built: true,
            role_note: "Frappe antinavire. Classe légère non conventionnée.",
            source: "§2.4",
        ),
        (
            id: "corvette",
            name: "Corvette",
            length_m: (min: 50, max: 150),
            crew: (min: 10, max: 80),
            hyperdrive: Yes,
            conventioned: true,
            ever_built: true,
            role_note: "Patrouille, escorte, raids.",
            source: "§2.4",
        ),
        (
            id: "fregate",
            name: "Frégate",
            length_m: (min: 200, max: 400),
            crew: (min: 100, max: 400),
            hyperdrive: Yes,
            conventioned: true,
            ever_built: true,
            role_note: "Polyvalente, cœur des escadres.",
            source: "§2.4",
        ),
        (
            id: "croiseur",
            name: "Croiseur",
            length_m: (min: 500, max: 1000),
            crew: (min: 1000),
            hyperdrive: Yes,
            conventioned: true,
            ever_built: true,
            always_named: true,
            role_note: "Ligne de bataille, commandement régional.",
            source: "§2.4",
        ),
        (
            id: "porte_vaisseaux",
            name: "Porte-vaisseaux",
            length_m: (min: 800, max: 1500),
            crew: (min: 3000),
            hyperdrive: Yes,
            conventioned: true,
            ever_built: true,
            always_named: true,
            role_note: "Transporte chasseurs et bombardiers.",
            source: "§2.4",
        ),
        (
            id: "cuirasse",
            name: "Cuirassé",
            length_m: (min: 1500),
            crew: (min: 5000),
            hyperdrive: Yes,
            conventioned: true,
            ever_built: true,
            always_named: true,
            role_note: "Suprématie, symbole de puissance, très rare.",
            source: "§2.4",
        ),
        (
            id: "vaisseau_capitale",
            name: "Vaisseau capitale",
            // Le canon dit « > 10 000 m » et « > 1 000 000 » : bornes basses strictes.
            length_m: (min: 10001),
            crew: (min: 1000001),
            hyperdrive: Yes,
            ever_built: false,
            always_named: true,
            role_note: "« Vaisseau-mère » : vaisseau-ville autonome pendant des années. N'a jamais existé (seul projet : le Souverain de Vorrh-V, abandonné).",
            source: "§2.4",
        ),
    ],
    categories: [
        (
            id: "specialises",
            name: "Vaisseaux spécialisés",
            note: "Taille entre frégate et croiseur, coques modifiées : expérimentaux (armement, moteur ou énergie expérimentale) ; transporteurs à haut risque (seuls autorisés pour le nucléaire, uniquement militaires). Exemple fondateur : les frégates d'antimatière d'Avrel Hex au Triomphe.",
            source: "§2.4",
        ),
        (
            id: "paramilitaires",
            name: "Paramilitaires",
            note: "Navires scientifiques (anciennes frégates ou anciens croiseurs réhabilités) ; transports militaires (anciennes frégates vidées et désarmées : carburant lourd, prisonniers, munitions, troupes, matériel, pièces détachées, remorquage), qui voyagent au cœur des flottes.",
            source: "§2.4",
        ),
        (
            id: "civils",
            name: "Civils",
            note: "Navettes, cargos (du tramp indépendant au convoi de guilde), paquebots (entre mondes reliés aux Portails), utilitaires (mineurs d'astéroïdes, remorqueurs, vaisseaux-hôpitaux, yachts).",
            source: "§2.4",
        ),
    ],
    prefixes: [
        (prefix: "VIV", meaning: "Vaisseau Impérial Vorrhen", faction: "empire", entity_note: "Empire", source: "§2.4"),
        (prefix: "NSU", meaning: "Navire de Service de l'Union", faction: "ugl", entity_note: "UGL", source: "§2.4"),
        (prefix: "FED", faction: "federation", entity_note: "La Fédération", source: "§2.4"),
        (prefix: "HC", meaning: "Hexa-Corp", faction: "hexa_corp", entity_note: "Flottes propres d'Hexa-Corp", source: "§2.4"),
        (prefix: "TOS", faction: "syndicat_tosear", entity_note: "Syndicat Tosear", source: "§2.4"),
        // Le préfixe est vu en public comme celui de pirates ; son rattachement à Tosear est secret.
        (prefix: "OXL", meaning: "faux pavillon pirate", faction: "syndicat_tosear", entity_note: "Flotte Nordique du Syndicat Tosear", secret: true, source: "§2.4"),
        (prefix: "GRT", faction: "royaume_grothul", entity_note: "Royaume Grothul", source: "§2.4"),
        (prefix: "ECR", faction: "ecorcheurs", entity_note: "Écorcheurs (disparus)", source: "§2.4"),
        // « Proposition non validée » dans le canon lui-même.
        (prefix: "UNS", meaning: "United Nations Ship (vieux Standard)", faction: "nations_unies", entity_note: "Nations Unies", status: AuthorDraft, source: "§2.4"),
    ],
)
