// Puissances, organisations et sous-organisations — transcription manuelle de l'export (§4).
// Les champs *_note sont internes (jamais affichés) ; les passages 🔒 vont dans secret_notes.
// Identifiants : ils doivent correspondre aux règles de rattachement de tools/sh_import.
(
    factions: [
        // --- Grandes puissances -------------------------------------------------------------
        (
            id: "empire",
            name: "L'Empire Vorrhen",
            short_name: "Empire",
            kind: Power,
            capital: "vorrhal",
            founded: "0at",
            ship_prefix: "VIV",
            leaders_note: "l'empereur Corvan Sarkis (15e empereur, depuis 400at) ; le Grand Amiral Ardan Vek",
            summary_note: "Empire autoritaire, humano-centré et méritocratique, né du Renouveau Impérial. Empereur « élu à vie » aux pleins pouvoirs, sénat sous veto absolu. Aucune religion. Espèces « libres mais non citoyennes ». Magie interdite et chassée. Production navale centralisée sur Vorrh et Ferrok ; État payé en Wuro ; la moitié de ses missiles sort d'Hexa-Corp (CLAV). Objectif : écraser l'UGL et détruire Concordia.",
            secret_notes: [
                "🔒 Finance la Ligue des Pirates.",
                "🔒 Pacte de Terminus avec le Syndicat Tosear (403at).",
                "🔒 EESS : programme secret d'exploration de la Zone Inexplorée depuis 320at.",
                "🔒 Carte secrète des passes de la nébuleuse du Croissant.",
                "🔒 Des Ethari servent en secret dans l'armée.",
                "🔒 La vengeance de Sarkis contre Myrth couve.",
            ],
            source: "§4.1",
        ),
        (
            id: "ugl",
            name: "Union Galactique Libre",
            short_name: "UGL",
            kind: Power,
            capital: "concordia",
            founded: "357at",
            ship_prefix: "NSU",
            leaders_note: "la Présidente Nyra Maren (élue en 411at, réélue en 419at, second mandat jusqu'en 427at)",
            summary_note: "Démocratie héritière revendiquée des Nations Unies : Présidence (mandat de 8 ans, 3 au plus), Sénat des Mondes, Conseil des Espèces. Laïque ; crédit officiel, Wuro interdit ; magie tolérée sous surveillance. Économie ruinée en reconstruction ; dispositif défensif massé au No Man's Land ; cliente d'Hexa-Corp (30 % de ses armes d'infanterie, CLPE).",
            secret_notes: [
                "🔒 Programme secret d'exploration de la Zone Inexplorée ; colonie de Vesper (405at) ; FSS et son cuirassé « détruit », le NSU Lumières.",
                "🔒 Protection de Myrth en sous-main.",
            ],
            source: "§4.2",
        ),
        (
            id: "fou",
            name: "Flottes Officielles de l'Union",
            short_name: "FOU",
            kind: MilitaryBranch,
            parent: "ugl",
            leaders_note: "le Grand Amiral Cassian Drey, qui ne dépend que de la Présidence",
            summary_note: "Flottes de l'État unioniste ; se reconstruisent autour du NSU Liberté (420at). Doctrine de projection.",
            source: "§4.2",
        ),
        (
            id: "fdu",
            name: "Flottes Décentralisées de l'Union",
            short_name: "FDU",
            kind: MilitaryBranch,
            parent: "ugl",
            leaders_note: "coordonnées par la Grande Amirale Petra Solen ; propriété des gouverneurs",
            summary_note: "Flottes des gouverneurs, intégrables aux FOU en temps de guerre ; personnel aux mêmes standards.",
            source: "§4.2",
        ),
        (
            id: "federation",
            name: "La Fédération",
            kind: Power,
            capital: "tharkast",
            founded: "350bt",
            ship_prefix: "FED",
            leaders_note: "le Chancelier Hakkon Skeld (au pouvoir depuis 391at, six victoires dans l'Arène)",
            summary_note: "Un seul système (Kholvar, sauf Sabraze et Vrasq), ≈ 23 Md d'habitants. Totalitaire, parti unique ; le Chancelier se gagne dans l'Arène de Tharkast tous les cinq ans. Militarisme intégral. Isolationnisme armé ; commerce et diplomatie via Sabraze ; chasse aux pirates. Perçue comme une « puissance régionale isolationniste ».",
            secret_notes: [
                "🔒 Construit la Flotte d'Attaque depuis 410at (4 cuirassés, 4 PV, 10 croiseurs en 425at ; 5, 6 et 15 d'ici 430at).",
                "🔒 L'ouverture diplomatique récente est une préparation.",
