// Mise en scène du système d'Hexis en vue Globale (proposition P15, docs/propositions.md).
// Le canon dit : chantiers orbitaux, L'Enclume en construction, seul hub de Portails reliant
// l'UGL et l'Empire (§3.3, §3.7). Il ne dit pas où : ces emplacements sont proposés.
(
    system: "sys_hexis",
    status: Proposition("P15"),
    // Nom d'affichage validé par l'auteur (P11, docs/QUESTIONS.md Q9).
    star_name: "Étoile d'Hexis",
    structures: [
        // Les chantiers orbitaux, voisins de L'Enclume (≈ 20 km) : le cœur industriel en orbite.
        (
            id: "hexis_shipyards",
            kind: Shipyard,
            name_key: "structure.hexis_shipyards",
            around: "hexis",
            altitude_radii: 1.5,
            angle_deg: 50.7,
            model: "models/space/shipyard.glb",
        ),
        // Le hub de Portails, un peu à l'écart (≈ 120 km) : trafic dense entre lui et les cales.
        (
            id: "hexis_portal_hub",
            kind: PortalHub,
            name_key: "structure.hexis_portal_hub",
            around: "hexis",
            altitude_radii: 1.5,
            angle_deg: 54.5,
            model: "models/space/portal_hub.glb",
        ),
    ],
    station_models: {
        "l_enclume": "models/space/l_enclume.glb",
    },
    // Cargos qui font la navette entre le hub, les chantiers et L'Enclume.
    traffic: (
        ships: 24,
        model: "models/space/freighter.glb",
        speed: 900.0,
    ),
    arrival: (
        near: "l_enclume",
        distance: 25000.0,
        // L'étoile de trois quarts : Hexis à demi éclairée derrière L'Enclume.
        azimuth_deg: -50.0,
        elevation_deg: 12.0,
    ),
)
