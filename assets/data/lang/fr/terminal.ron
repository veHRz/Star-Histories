    // --- Dialogues : bureau des contrats (P25) ------------------------------------------------
    "dlg.office.name": "Bureau des contrats d'Hexa-Corp",
    "dlg.office.first": "Un employé en gris Hexa-Corp lève les yeux de trois écrans à la fois. « Nouvelle tête. Contrats ou Banque ? C'est le même comptoir. Hexa-Corp sert tout le monde, capitaine, tant qu'on paie et qu'on livre. »",
    "dlg.office.again": "« Capitaine. » L'employé ne lève pas les yeux. « Contrats, ou Banque ? »",
    "dlg.office.trusted": "L'employé sourit presque. « Capitaine. Vos livraisons arrivent à l'heure ; ça se remarque, là-haut. Que peut faire la Logistique pour vous ? »",
    "dlg.office.ask_work": "Je cherche du travail.",
    "dlg.office.ask_bank": "À propos de mon hypothèque.",
    "dlg.office.bye": "Ce sera tout.",
    "dlg.office.back": "Autre chose.",
    "dlg.office.work": "« Transport, ravitaillement, remorquage. La cargaison est à nous, le vaisseau est à vous, le délai est dans le contrat. Vous livrez, vous êtes payé sur-le-champ. »",
    "dlg.office.show_contracts": "Montrez-moi les contrats ouverts.",
    "dlg.office.ask_rules": "Et si quelque chose tourne mal ?",
    "dlg.office.rules": "« Un retard est un échec, et les échecs vont dans votre dossier. Une cargaison vendue ailleurs est une rupture de contrat : chaque caisse est enregistrée, nous le savons toujours. La Corporation vous facturera deux fois sa valeur et fermera votre dossier. Certains capitaines croient la galaxie assez grande pour s'y cacher. Elle ne l'est pas. »",
    "dlg.office.bank": "L'employé tourne un autre écran vers vous : votre vaisseau, l'hypothèque, l'échéancier. « Une échéance tous les trente jours. Trois manquées, et la Banque se sert automatiquement. C'est aussi dans le contrat. »",
    "dlg.office.pay": "Payer l'échéance.",
    "dlg.office.show_account": "Montrez-moi le relevé du compte.",
    "dlg.office.paid": "« Reçu. La Banque vous remercie. »",
    "dlg.office.closed": "Les écrans de l'employé s'éteignent l'un après l'autre. « Votre dossier est clos, capitaine. Hexa-Corp n'a plus rien pour vous. La Banque, elle, attend toujours son argent. »",
    "dlg.office.bank_closed": "« Votre dette ne se ferme pas avec votre dossier. Payez, ou la Banque se servira. »",
    // --- Dialogues : guichet de la Banque (P25, M9) -------------------------------------------
    "dlg.bank.name": "Guichet de la Banque",
    "dlg.bank.first": "Derrière une vitre épaisse, un employé de la Banque vérifie votre identité sur son écran. « Hypothèque, échéances, change au taux d'Hexis : tout passe par ce guichet, capitaine. »",
    "dlg.bank.again": "« Capitaine. » L'employé fait pivoter son écran vers vous. « Votre compte. »",
    "dlg.bank.closed": "L'employé ne sourit pas. « Votre dossier chez Hexa-Corp est clos, capitaine. Votre dette, elle, ne l'est pas. »",
    "dlg.bank.show_account": "Montrez-moi mon compte.",
    "dlg.bank.pay": "Payer l'échéance.",
    "dlg.bank.paid": "« Reçu. La Banque vous remercie. »",
    "dlg.bank.bye": "Ce sera tout.",
    // --- Dialogues : comptoir du marché (P25, M9) ---------------------------------------------
    "dlg.market.name": "Comptoir du marché",
    "dlg.market.first": "Un marchand fait défiler les cours sur sa tablette sans lever les yeux. « Les prix bougent tous les jours, capitaine. Vous achetez, vous vendez, ou vous regardez ? »",
    "dlg.market.again": "Le marchand vous reconnaît d'un signe de tête. « Les cours du jour sont affichés. »",
    "dlg.market.show_prices": "Montrez-moi les cours.",
    "dlg.market.bye": "Pas aujourd'hui.",
    // --- Dialogues : bureau du chantier (P25, M9) ---------------------------------------------
    "dlg.shipyard.name": "Bureau du chantier",
    "dlg.shipyard.first": "Un agent en combinaison tachée d'huile consulte l'état de votre vaisseau sur un écran fissuré. « On répare tout ce qui vole, capitaine, au point de dégât. Et on facture pareil. »",
    "dlg.shipyard.again": "« Capitaine. Votre vaisseau tient toujours ? »",
    "dlg.shipyard.traitor": "L'agent vous dévisage. « On m'a parlé de vous. Le chantier répare quand même : votre argent vaut celui d'un autre. »",
    "dlg.shipyard.ask_repair": "Faites-moi un devis de réparation.",
    "dlg.shipyard.ask_fuel": "Il me faut du carburant lourd.",
    "dlg.shipyard.bye": "Ce sera tout.",
    // --- Dialogues : comptoir de la taverne (P25) ---------------------------------------------
    "dlg.tavern.name": "Comptoir de la taverne",
    "dlg.tavern.first": "Le tavernier fait glisser un verre vers vous avant que vous demandiez. « Première fois sur Hexis ? Les impériaux à gauche, les unionistes à droite, et personne ne tire ici. Qu'est-ce que je vous sers ? »",
    "dlg.tavern.again": "« Encore vous, capitaine. » Un verre vous attend déjà.",
    "dlg.tavern.traitor": "Le tavernier sert, mais garde une main sous le comptoir. « Les nouvelles vont vite sur Hexis, capitaine. Buvez, et pas d'histoires. »",
    "dlg.tavern.ask_news": "Qu'est-ce qui se dit au port ?",
    "dlg.tavern.news": "« Voilà ce que racontent les équipages : »",
    "dlg.tavern.bye": "Merci. J'y vais.",
}
