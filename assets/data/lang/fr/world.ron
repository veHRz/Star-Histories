// Le monde à pied (M9, lot L3) : invites d'interaction, consoles, objets du catalogue
// (assets/data/gameplay/items.ron).
{
    "interact.seat.leave_helm_docked": "[KeyF] : se lever   ·   [KeyG] : demander le départ",
    "console.departures.name": "le tableau des départs",
    "console.departures.message": "Tous les postes d'amarrage sont en service. Le hub de Portails est ouvert à tous.",
    "console.contracts.name": "le terminal des contrats d'Hexa-Corp",
    "console.contracts.message": "Les contrats ouvriront bientôt.",
    "console.market.name": "le terminal du marché",
    "console.market.message": "Le marché ouvrira bientôt.",
    "console.bar.name": "le comptoir de la taverne",
    "console.bar.message": "Le tavernier vous fait signe et fait glisser un verre vers vous.",
    "interact.door.open": "[KeyE] : ouvrir la porte",
    "interact.door.close": "[KeyE] : fermer la porte",
    "interact.console": "[KeyE] : utiliser {console}",
    "interact.seat.sit": "[KeyE] : s'asseoir",
    "interact.seat.leave": "[KeyE] : se lever",
    "interact.seat.leave_helm": "[KeyF] : se lever",
    "interact.pickup": "[KeyE] : ramasser — {item}",
    "interact.ladder": "[KeyE] : grimper",
    // Porte du sas d'un vaisseau en vol (M10) : elle ne s'ouvre pas sur le vide.
    "interact.door.void": "Sas extérieur : vide spatial",
    // Casiers (M10) : un casier décoratif ou qui n'est pas à vous est verrouillé ; un casier
    // nommé (sa plaque) donne son nom. L'invite sans nom vient de son genre (`container.*`).
    "interact.locker.locked": "Casier verrouillé",
    "interact.locker.named": "[KeyE] : ouvrir « {name} »",
    "interact.locker_label": "[KeyE] : nommer le casier",
    "interact.locker_label.named": "[KeyE] : renommer « {name} »",
    // Genres des rangements (`kind_key` de gameplay/items.ron ; aucun : le casier) : le titre,
    // `.open` l'invite, `.refused` le refus d'un objet, `.stock` le compteur de son écran.
    "container.locker": "Casier",
    "container.locker.open": "[KeyE] : ouvrir le casier",
    "container.fridge": "Frigo",
    "container.fridge.open": "[KeyE] : ouvrir le frigo",
    "container.fridge.refused": "Le frigo ne garde que la nourriture : {item} reste avec vous.",
    "container.fridge.stock": "Rations : {count}",
    // PNJ de comptoir (M10) : le rôle d'abord, avec sa majuscule, l'action sur une seconde ligne.
    "interact.npc": "[KeyE] : parler",
    "interact.npc.with": "{role}\n[KeyE] : parler",
    // PNJ de comptoir (paramètre `role` d'un `INTERACT_*` de genre `npc`) : anonymes et
    // génériques, en minuscules (ils se glissent dans une phrase ; l'invite et le terminal leur
    // mettent une majuscule).
    "npc.role.contracts": "guichetier des contrats",
    "npc.role.bank": "employé de la Banque",
    "npc.role.market": "marchand",
    "npc.role.shipyard": "agent du chantier",
    "npc.role.bar": "tavernier",
    "notice.picked_up": "Ramassé : {item}",
    "notice.ladder": "L'échelle n'est pas encore utilisable.",
    "item.spare_parts": "pièces détachées",
    "item.datapad": "tablette",
    "console.helm.name": "la console de pilotage",
    "console.helm.message": "Pilotage : asseyez-vous au siège du pilote, devant cette console, pour prendre les commandes.",
    "console.navigation.name": "la console de navigation",
    "console.navigation.message": "Navigation : aucune route tracée.",
    "console.comms.name": "la console de communications",
    "console.comms.message": "Communications : aucun nouveau message.",
    "console.engineering.name": "la console de la salle des machines",
    "console.engineering.message": "Machines : réacteur nominal, réserves de carburant lourd pleines.",
    "console.galley.name": "le terminal de la cuisine",
    "console.galley.message": "Cuisine : rations en stock.",
    // Catalogue d'objets (gameplay/items.ron) : `item.<id>` est le nom, en minuscules (il se
    // glisse dans une phrase : « Ramassé : tablette ») ; `item.<id>.description`, la fiche.
    "item.datapad.description": "Une tablette de bord, écran rayé, batterie fatiguée. Elle garde vos notes et vos relevés.",
    "item.spare_parts.description": "Joints, fusibles, raccords : de quoi garder un vieux vaisseau en état de voler.",
    "item.mag_pistol": "pistolet magnétique",
    "item.mag_pistol.description": "Une arme de poing à propulsion magnétique. Rien de luxueux, mais elle tire juste.",
    "item.flight_suit": "combinaison de vol",
    "item.flight_suit.description": "La combinaison pressurisable des équipages, renforcée aux coudes et aux genoux.",
    "item.toolkit": "trousse à outils",
    "item.toolkit.description": "Clés, sondes et une soudeuse de poche : l'essentiel pour réparer à bord.",
    "item.medkit": "trousse de soins",
    "item.medkit.description": "Pansements, agrafes et injecteurs : de quoi tenir jusqu'au prochain port.",
    "item.ration": "ration de survie",
    "item.ration.description": "Une ration scellée, nourrissante et sans goût. Elle se garde des années.",
    "item.data_chip": "puce de données",
    "item.data_chip.description": "Une puce de stockage. Son contenu reste à lire.",
    "item.cargo_manifest": "manifeste de cargaison",
    "item.cargo_manifest.description": "La liste des caisses d'une cargaison, tamponnée par le port de départ.",
    // Catégories et emplacements d'équipement (`ItemCategory::key`, `EquipSlot::key`).
    "item.category.equipment": "Équipement",
    "item.category.tool": "Outil",
    "item.category.consumable": "Consommable",
    "item.category.document": "Document",
    "item.category.material": "Matériaux",
    "item.slot.weapon": "Arme",
    "item.slot.outfit": "Tenue",
    "item.slot.tool": "Outil",
