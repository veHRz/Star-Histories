    "tutorial.skip_confirm": "Appuyez encore sur [KeyH] pour passer le tutoriel.",
    "tutorial.skipped": "Tutoriel passé. Les conseils prendront le relais quand il le faudra.",
    "tutorial.finished": "Tutoriel terminé : vous savez l'essentiel. Bonne route, capitaine.",
