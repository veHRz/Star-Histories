// Options et touches (M9, lot L1) : onglets et réglages de l'écran des options, menu des touches
// (une page par catégorie, `options.keys.page.<catégorie>` ; une ligne par action remappable,
// `options.action.<action>`, voir `input::KEY_ACTIONS`), noms des dispositions de clavier
// (`options.layout.<id>`, `gameplay/keyboard.ron`) et noms des touches (`key.<KeyCode>`, lus par
// `Lang::key_label` ; les lettres et les chiffres n'en ont pas besoin).
{
    "key.Space": "Space",
    "key.ControlLeft": "Ctrl",
    "key.ControlRight": "Right Ctrl",
    "key.ShiftLeft": "Shift",
    "key.ShiftRight": "Right Shift",
    "key.AltLeft": "Alt",
    "key.Escape": "Esc",
    "key.Enter": "Enter",
    "key.Tab": "Tab",
    "key.Backspace": "Backspace",
    "key.CapsLock": "Caps Lock",
    "key.Insert": "Ins",
    "key.Delete": "Del",
    "key.Backquote": "`",
    "key.Minus": "-",
    "key.Equal": "=",
    "key.BracketLeft": "[",
    "key.BracketRight": "]",
    "key.Semicolon": ";",
    "key.Quote": "'",
    "key.Comma": ",",
    "key.Period": ".",
    "key.Slash": "/",
    "key.Backslash": "\\",
    "key.IntlBackslash": "<",
    // Une action sans touche (case vide).
    "key.None": "—",

    "options.tab.general": "General",
