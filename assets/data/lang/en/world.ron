// Le monde à pied (M9, lot L3) : invites d'interaction, consoles, objets du catalogue
// (assets/data/gameplay/items.ron).
{
    "interact.seat.leave_helm_docked": "[KeyF]: Stand up   ·   [KeyG]: Request departure",
    "console.departures.name": "departures board",
    "console.departures.message": "All docking slots in service. The Portal hub is open to all traffic.",
    "console.contracts.name": "Hexa-Corp contract terminal",
    "console.contracts.message": "Contract listings will open soon.",
    "console.market.name": "market terminal",
    "console.market.message": "Trading will open soon.",
    "console.bar.name": "tavern counter",
    "console.bar.message": "The barkeep nods and slides a glass your way.",
    "interact.door.open": "[KeyE]: Open door",
    "interact.door.close": "[KeyE]: Close door",
    "interact.console": "[KeyE]: Use {console}",
    "interact.seat.sit": "[KeyE]: Sit down",
    "interact.seat.leave": "[KeyE]: Stand up",
    "interact.seat.leave_helm": "[KeyF]: Stand up",
    "interact.pickup": "[KeyE]: Take {item}",
    "interact.ladder": "[KeyE]: Climb",
    // Porte du sas d'un vaisseau en vol (M10) : elle ne s'ouvre pas sur le vide.
    "interact.door.void": "Outer airlock: open space",
    // Casiers (M10) : un casier décoratif ou qui n'est pas à vous est verrouillé ; un casier
    // nommé (sa plaque) donne son nom. L'invite sans nom vient de son genre (`container.*`).
    "interact.locker.locked": "Locker locked",
    "interact.locker.named": "[KeyE]: Open “{name}”",
    "interact.locker_label": "[KeyE]: Name the locker",
    "interact.locker_label.named": "[KeyE]: Rename “{name}”",
    // Genres des rangements (`kind_key` de gameplay/items.ron ; aucun : le casier) : le titre,
    // `.open` l'invite, `.refused` le refus d'un objet, `.stock` le compteur de son écran.
    "container.locker": "Locker",
    "container.locker.open": "[KeyE]: Open locker",
    "container.fridge": "Fridge",
    "container.fridge.open": "[KeyE]: Open fridge",
    "container.fridge.refused": "The fridge only keeps food: the {item} stays with you.",
    "container.fridge.stock": "Rations: {count}",
    // PNJ de comptoir (M10) : le rôle d'abord, avec sa majuscule, l'action sur une seconde ligne.
    "interact.npc": "[KeyE]: Talk",
    "interact.npc.with": "{role}\n[KeyE]: Talk",
    // PNJ de comptoir (paramètre `role` d'un `INTERACT_*` de genre `npc`) : anonymes et
    // génériques, en minuscules (ils se glissent dans une phrase ; l'invite et le terminal leur
    // mettent une majuscule).
    "npc.role.contracts": "contracts clerk",
    "npc.role.bank": "Bank clerk",
    "npc.role.market": "trader",
    "npc.role.shipyard": "shipyard agent",
    "npc.role.bar": "barkeep",
    "notice.picked_up": "Picked up: {item}",
    "notice.ladder": "The ladder is not usable yet.",
    "item.spare_parts": "spare parts",
    "item.datapad": "datapad",
    "console.helm.name": "helm console",
    "console.helm.message": "Helm: sit in the pilot's seat, in front of this console, to take the controls.",
    "console.navigation.name": "navigation console",
    "console.navigation.message": "Navigation: no course plotted.",
    "console.comms.name": "comms console",
    "console.comms.message": "Comms: no new messages.",
    "console.engineering.name": "engineering console",
    "console.engineering.message": "Engineering: reactor nominal, heavy fuel reserves full.",
    "console.galley.name": "galley terminal",
    "console.galley.message": "Galley: rations stocked.",
    // Catalogue d'objets (gameplay/items.ron) : `item.<id>` est le nom, en minuscules (il se
    // glisse dans une phrase) ; `item.<id>.description`, la fiche.
    "item.datapad.description": "A shipboard datapad, scratched screen, tired battery. It keeps your notes and readings.",
    "item.spare_parts.description": "Seals, fuses, couplings: enough to keep an old ship flying.",
    "item.mag_pistol": "magnetic pistol",
    "item.mag_pistol.description": "A magnetically driven sidearm. Nothing fancy, but it shoots straight.",
    "item.flight_suit": "flight suit",
    "item.flight_suit.description": "The pressurisable suit of ship crews, reinforced at the elbows and knees.",
    "item.toolkit": "toolkit",
    "item.toolkit.description": "Wrenches, probes and a pocket welder: the essentials for onboard repairs.",
    "item.medkit": "medkit",
    "item.medkit.description": "Dressings, staples and injectors: enough to hold on until the next port.",
    "item.ration": "survival ration",
    "item.ration.description": "A sealed ration, nourishing and tasteless. It keeps for years.",
    "item.data_chip": "data chip",
    "item.data_chip.description": "A storage chip. Its contents are yet to be read.",
    "item.cargo_manifest": "cargo manifest",
    "item.cargo_manifest.description": "The crate list of a cargo, stamped by the port of departure.",
    // Catégories et emplacements d'équipement (`ItemCategory::key`, `EquipSlot::key`).
    "item.category.equipment": "Equipment",
    "item.category.tool": "Tool",
    "item.category.consumable": "Consumable",
    "item.category.document": "Document",
    "item.category.material": "Materials",
    "item.slot.weapon": "Weapon",
    "item.slot.outfit": "Outfit",
    "item.slot.tool": "Tool",
}
