// Tutoriel guidé (M8, M9 ; crates/sh_game/src/tutorial.rs). {place} : le système où l'on est,
// puis la destination du contrat ; {beacon} : la balise d'approche du port ; {room} : le nom
// d'une salle du vaisseau (lang/en/rooms.ron) ; {item} : le nom d'un objet. Le rôle des salles
// est celui du jeu tel qu'il est (vérifié dans le code), sans mécanique promise.
{
    "tutorial.header": "TUTORIAL · STEP {n} OF {total}",
    "tutorial.skip_hint": "[KeyH] twice: skip the tutorial. It can also be turned off in the options.",
    "tutorial.skip_confirm": "Press [KeyH] again to skip the tutorial.",
    "tutorial.skipped": "Tutorial skipped. Tips will take over when needed.",
    "tutorial.finished": "Tutorial complete: you know the essentials. Fair travels, captain.",
    "tutorial.marker.label": "{name} · {distance}",
    "tutorial.marker.meters": "{distance} m",
    "tutorial.marker.kilometers": "{distance} km",
    "tutorial.marker.locker": "Locker",
    "tutorial.marker.pickup": "To pick up: {item}",
    "tutorial.marker.office": "Contract office",
    "tutorial.marker.helm": "Pilot's seat",
    "tutorial.cabin.title": "Your cabin",
    "tutorial.cabin.body": "Your ship is in orbit, and here you are in your cabin: the bunk, a desk, lockers to stow your belongings. Aim at a locker and press [KeyE] to open it, pick up the datapad lying on the desk ([KeyE]), then open your inventory ([KeyI]). [Escape] closes these screens.",
    "tutorial.check.locker": "Open a locker ([KeyE])",
    "tutorial.check.pickup": "Pick up the datapad ([KeyE])",
    "tutorial.check.inventory": "Open the inventory ([KeyI])",
    "tutorial.tour.title": "Tour of the ship",
    "tutorial.tour.body": "Visit each room, in any order: [KeyE] opens doors, the marker shows the next one. The tour ends in the cockpit, at the front.",
    "tutorial.check.visit_quarters": "{room}: the crew's bunks; you travel without a crew",
    "tutorial.check.visit_mess": "{room}: the common room, its galley and its table",
    "tutorial.check.visit_airlock": "{room}: the ship's only way out, when docked",
    "tutorial.check.visit_hold": "{room}: contract cargo; a contract is only taken if it fits",
    "tutorial.check.visit_engine": "{room}: the reactor and the heavy fuel every voyage burns",
    "tutorial.check.visit_cockpit": "{room}: fly, open the map, depart and dock",
    "tutorial.flight.title": "Take the helm",
    "tutorial.flight.body": "Sit at the helm: aim at the pilot's seat and press [KeyE]. The mouse steers the ship, [KeyW] thrusts forward. Hold [ShiftLeft] to cruise: that is how you cross the system.",
    "tutorial.check.look": "Steer the ship (mouse)",
    "tutorial.check.thrust": "Thrust ([KeyW])",
    "tutorial.check.cruise": "Cruise ([ShiftLeft] held)",
    "tutorial.dock.title": "Reach the spaceport",
    "tutorial.dock.body": "Follow the marker to the “{beacon}” beacon. Within range, press [KeyG]: the approach and docking are automatic.",
    "tutorial.check.dock": "Dock ([KeyG] near the beacon)",
    "tutorial.office.title": "Go ashore",
    "tutorial.office.body": "Stand up ([KeyF]) and leave the ship through the airlock, then the gangway: you are in the hangar; [KeyE] opens doors. Through the corridor, reach the arrivals hall, then the Hexa-Corp contract office.",
    "tutorial.check.stand": "Stand up ([KeyF])",
    "tutorial.check.hangar": "Leave through the airlock, into the hangar",
    "tutorial.check.hall": "Cross the arrivals hall",
    "tutorial.check.office": "Enter the contract office",
    "tutorial.contract.title": "Take a contract",
    "tutorial.contract.body": "Aim at the clerk, behind the counter, and press [KeyE]. Ask for work, then accept a transport (CT) or resupply (CR) contract: its cargo must be delivered to another system.",
    "tutorial.check.talk": "Talk to the clerk ([KeyE])",
    "tutorial.check.contract": "Accept a transport contract",
    "tutorial.screens.title": "Keep track",
    "tutorial.screens.body": "Your contract is noted in the mission log. Open the log ([KeyJ]), the captain's record ([KeyC]: reputations, loans) or the character screen ([KeyI]: inventory, [KeyO]: skills), and the codex ([KeyK]); [Escape] closes them.",
    "tutorial.check.journal": "Mission log ([KeyJ])",
    "tutorial.check.sheet": "Captain's record ([KeyC]) or character ([KeyI], [KeyO])",
    "tutorial.check.codex": "Codex ([KeyK])",
    "tutorial.departure.title": "Hit the road",
    "tutorial.departure.body": "Go back to the pilot's seat, at the front, and sit down ([KeyE]). [KeyG] leaves the dock. In flight, open the galaxy map ([KeyM]) and click the contract's destination: {place}.",
    "tutorial.check.helm": "Sit at the helm",
    "tutorial.check.undock": "Leave the dock ([KeyG])",
    "tutorial.check.map": "Open the map ([KeyM])",
    "tutorial.check.route": "Choose the destination: {place}",
    "tutorial.delivery.title": "Deliver the cargo",
    "tutorial.delivery.body": "On the map, [Digit1] leaves by the Portals ([Digit2]: by hyperspace, much longer). On arrival, near the Portal hub or the shipyards, press [KeyG]: Hexa-Corp tugs take the cargo and the contract is paid.",
    "tutorial.check.arrive": "Reach the destination: {place}",
    "tutorial.check.deliver": "Deliver and get paid ([KeyG])",
    "tutorial.save.title": "Save",
    "tutorial.save.body": "[F5] makes a quick save; [Escape] also opens the pause menu and its “Save” button. You can save docked or in flight, never in the middle of a fight.",
    "tutorial.save.body_ironman": "Ironman: the game saves itself, docked, on arrival and when quitting. Wait for the next automatic save.",
    "tutorial.check.save": "Save the game ([F5])",
}
