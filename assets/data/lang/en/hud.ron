// Interface en jeu (M9, lot L2) : aides des vues, HUD de vol et de combat, conseils de
// première fois (crates/sh_game/src/tips.rs).
{
    "combat.hud.title": "Hull",
    "combat.hud.section": "{section}: armor {armor}% · structure {structure}%",
    "combat.hud.core": "Core: {core}%",
    "combat.hud.ammo": "Missiles: {missiles}   ·   Decoys: {decoys}",
    "combat.hud.hint": "Left click: guns   ·   Right click: missile   ·   [KeyX]: decoys",
    "combat.section.bow": "Bow",
    "combat.section.stern": "Stern",
    "combat.section.port": "Port",
    "combat.section.starboard": "Starboard",
    "tips.title": "Tip",
    "tips.helm": "At the helm: [KeyW][KeyA][KeyS][KeyD] and [Space]/[ControlLeft] to thrust, the mouse to steer, [KeyQ]/[KeyE] to roll. [ShiftLeft]: cruise, to cross the system. [KeyF]: stand up.",
    "tips.dock": "To dock at the spaceport, approach the “Spaceport approach” beacon and press [KeyG]: the manoeuvre is automatic. [KeyM] opens the galaxy map.",
    "tips.port": "Docked. The spaceport hall leads to the Hexa-Corp contract office, the market and the tavern: [KeyE] to talk or use a console. [KeyC]: your record, [KeyJ]: the log, [KeyK]: the codex.",
    "tips.foot": "You are walking in your ship: [KeyE] opens doors and uses consoles. The pilot's seat is in the cockpit, at the front.",
    "tips.map": "The map: click a system to plot a route, then [Digit1] to leave by Portals or [Digit2] by hyperspace. [KeyM]: back to the helm.",
    "tips.contract": "Your contract is in the log ([KeyJ]). Deliver in orbit at the destination: [KeyG] near the Portal hub or the shipyards.",
    "tips.raid": "Combat! Left click: cannons, right click: missile at the target, [KeyX]: decoys. No cruise within 8 km of a hostile: move away to flee.",
    "tips.boarding": "Boarders! Left click: shoot, [KeyR]: reload, [ControlLeft]: crouch behind cover.",
    "view.global.hint": "At the helm: [KeyW][KeyA][KeyS][KeyD], [Space]/[ControlLeft]: thrust   ·   Mouse: steer   ·   [KeyQ]/[KeyE]: roll   ·   [ShiftLeft]: cruise   ·   [KeyZ]: flight assist   ·   [KeyG]: dock   ·   [KeyF]: stand up   ·   [KeyC]: record   ·   [KeyJ]: log   ·   [KeyK]: codex   ·   [Escape]: pause",
    "view.sector.hint": "[KeyW][KeyA][KeyS][KeyD]: move   ·   Mouse: look   ·   [ShiftLeft]: run   ·   [KeyC]: record   ·   [KeyJ]: log   ·   [KeyK]: codex   ·   [Escape]: pause",
    "hud.flight.dock": "[KeyG]: Request docking — {name}, {distance} km",
    "hud.flight.speed_ms": "{value} m/s",
    "hud.flight.speed_kms": "{value} km/s",
    "hud.flight.mode.assisted": "Flight assist",
    "hud.flight.mode.decoupled": "Decoupled",
    "hud.flight.mode.cruise": "Cruise",
    "hud.flight.nearest": "{name}: {distance} km",
}
