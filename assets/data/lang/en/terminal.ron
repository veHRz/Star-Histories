    "refuel.field.full": "Full tank",
    "refuel.full": "The tank is full.",
    "refuel.short": "A full tank costs more than your account: refuel in steps.",
    "refuel.note": "One day of travel burns one day of fuel. The yard gives no credit.",
    "refuel.no_tank": "No tank readings.",
    "refuel.full_do": "Fill the tank ({days} d · {cost})",
    "refuel.step_do": "Refuel {days} days ({cost})",
