    "repair.field.cost": "Full overhaul",
    "repair.field.after": "Account after payment",
    "repair.note": "Armor, structure and core are restored where they were damaged.",
    "repair.intact": "Your ship is in perfect condition.",
    "repair.not_here": "The shipyards of this system do not take your ship.",
    "repair.no_hull": "No hull readings.",
    "repair.do": "Repair the ship ({cost})",
    "repair.partial": "Repair what you can pay for ({paid} of {cost})",
    "repair.done": "Ship repaired: {cost} paid.",
    // Ravitaillement en carburant lourd (M9) : la réserve se compte en jours de route.
    "term.readout.fuel": "Heavy fuel",
    "refuel.panel": "Heavy fuel",
    "refuel.tank": "Tank",
    "refuel.days_value": "{have} / {capacity} d",
