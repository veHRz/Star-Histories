    "career.error.no_debt": "You owe nothing.",
    // --- Contrats -----------------------------------------------------------------------------
    "contracts.title": "Open contracts",
    "contracts.none": "No contract open for you today.",
    "contracts.refused_title": "Access denied",
    "contracts.refused": "Your file is closed.",
    "contracts.accept": "Accept the contract",
    "contracts.delivery": "Cargo is supplied by {issuer}. Deliver in orbit at the destination: our tugs meet you near the Portal hub or the shipyards.",
    "contracts.towing": "A derelict drifts near the system's shipyards: hook it ([KeyG] in range), then tow it to the shipyards.",
