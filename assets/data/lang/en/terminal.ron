    // --- Journal, fiche, codex ----------------------------------------------------------------
    "journal.title": "Mission log",
    "journal.none": "No contract in progress.",
    "journal.history": "Recent events",
    "journal.empty": "Nothing yet.",
    "journal.state.active": "In progress",
    "journal.state.towed": "Derelict in tow",
    "journal.state.find_wreck": "Find the derelict near the shipyards",
    "sheet.title": "Captain's record",
    "sheet.panel.account": "Account and hold",
    "sheet.panel.reputation": "Standing",
    "sheet.panel.skills": "Skills",
    "sheet.field.debt": "Mortgage ({lender})",
    "sheet.field.next_due": "Next installment",
    "sheet.field.no_debt": "Debt",
    "sheet.no_debt": "None",
    "sheet.count": "×{count}",
    "sheet.rep_value": "{tier} ({value})",
    "sheet.with_rank": "{standing} · {rank}",
    "sheet.closed": "{standing} · closed",
    "sheet.no_reputation": "No organisation knows you yet.",
    "sheet.traits": "Traits: {traits}",
    "sheet.character": "Character screen",
    "codex.title": "Codex",
    "codex.empty": "Nothing discovered yet.",
    "codex.type.place": "System",
    "codex.type.faction": "Organisation",
    // --- Dialogues : bureau des contrats (P25) ------------------------------------------------
    "dlg.office.name": "Hexa-Corp contract office",
    "dlg.office.first": "A clerk in the grey of Hexa-Corp looks up from three screens at once. \"New face. Here for a contract? Hexa-Corp serves everyone, captain, as long as they pay and deliver.\"",
    "dlg.office.again": "\"Captain.\" The clerk does not look up. \"A contract?\"",
    "dlg.office.trusted": "The clerk almost smiles. \"Captain. Your deliveries arrive on time; that gets noticed upstairs. What can Logistics do for you?\"",
    "dlg.office.ask_work": "I'm looking for work.",
    "dlg.office.bye": "That's all.",
    "dlg.office.back": "Something else.",
    "dlg.office.work": "\"Transport, resupply, towing. The cargo is ours, the ship is yours, the deadline is in the contract. Deliver and you are paid on the spot.\"",
    "dlg.office.show_contracts": "Show me the open contracts.",
    "dlg.office.ask_rules": "What if something goes wrong?",
    "dlg.office.rules": "\"Late is a failure, and failures are on your file. A cargo sold elsewhere is a breach: every crate is registered, we always know. The Corporation will bill you twice its value and close your file. Some captains think the galaxy is large enough to hide in. It is not.\"",
    "dlg.office.closed": "The clerk's screens go dark one after the other. \"Your file is closed, captain. Hexa-Corp has nothing for you. The Bank, however, still expects its money.\"",
    // --- Dialogues : guichet de la Banque (P25, M9) -------------------------------------------
    "dlg.bank.name": "Bank counter",
    "dlg.bank.first": "Behind thick glass, a Bank clerk checks your identity on a screen. \"Mortgage, installments, exchange at the Hexis rate: it all goes through this counter, captain.\"",
    "dlg.bank.again": "\"Captain.\" The clerk swivels a screen towards you. \"Your account.\"",
    "dlg.bank.closed": "The clerk does not smile. \"Your file with Hexa-Corp is closed, captain. Your debt is not.\"",
    "dlg.bank.show_account": "Show me my account.",
    // {installment} : le montant de la prochaine échéance (`terminal/page.rs::dialogue_args`).
    "dlg.bank.pay": "Pay the installment ({installment}).",
    "dlg.bank.paid": "\"Received. The Bank thanks you.\"",
    "dlg.bank.bye": "That's all.",
    // --- Dialogues : comptoir du marché (P25, M9) ---------------------------------------------
    "dlg.market.name": "Market counter",
    "dlg.market.first": "A trader scrolls through prices on a datapad without looking up. \"Prices move every day, captain. Buying, selling, or just looking?\"",
    "dlg.market.again": "The trader recognises you with a nod. \"Today's prices are posted.\"",
    "dlg.market.show_prices": "Show me the prices.",
    "dlg.market.bye": "Not today.",
    // --- Dialogues : bureau du chantier (P25, M9) ---------------------------------------------
    "dlg.shipyard.name": "Shipyard office",
    "dlg.shipyard.first": "An agent in an oil-stained suit checks your ship's condition on a cracked screen. \"We fix anything that flies, captain, wherever it's damaged. And we bill the same way.\"",
    "dlg.shipyard.again": "\"Captain. Your ship still holding together?\"",
    "dlg.shipyard.traitor": "The agent sizes you up. \"I've heard about you. The yard repairs all the same: your money is as good as anyone's.\"",
    "dlg.shipyard.ask_repair": "Give me a repair quote.",
    "dlg.shipyard.ask_fuel": "I need heavy fuel.",
    "dlg.shipyard.bye": "That's all.",
    // --- Dialogues : comptoir de la taverne (P25) ---------------------------------------------
    "dlg.tavern.name": "Tavern counter",
    "dlg.tavern.first": "The barkeep slides a glass your way before you ask. \"First time on Hexis? Imperials on the left, Unionists on the right, nobody shoots in here. What'll it be?\"",
    "dlg.tavern.again": "\"Back again, captain.\" A glass is already waiting.",
    "dlg.tavern.traitor": "The barkeep pours, but keeps a hand under the counter. \"Word travels fast on Hexis, captain. Drink, and don't make trouble.\"",
    "dlg.tavern.ask_news": "What's the word around the port?",
    "dlg.tavern.news": "\"Here's what the crews are saying:\"",
    "dlg.tavern.bye": "Thanks. I'll be going.",
}
